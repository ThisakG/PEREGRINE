# The base URL of the deployed Peregrine backend. During local development
# this points at your locally-running Express server; in production it
# points at wherever you host the backend (see the hosting guide).
# NOTE: this is the ONLY env var the frontend needs - it must never contain
# any API key, because everything the frontend ships is visible to anyone
# who opens their browser's dev tools. All secret keys stay server-side.
VITE_API_BASE_URL=http://localhost:8080
