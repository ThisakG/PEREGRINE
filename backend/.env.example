# =============================================================================
# Peregrine backend - environment variables template
# -----------------------------------------------------------------------------
# WHY THIS FILE EXISTS (secure coding practice):
#   Real secrets are NEVER hardcoded in source files or committed to git.
#   Copy this file to ".env" (which .gitignore excludes from version control),
#   fill in the real values from your own API_KEYS.txt / provider dashboards,
#   and the app reads them at runtime via src/config/env.js.
#   On your hosting platform (Render/Railway/etc.) you set these same
#   variable names in the platform's "Environment Variables" / "Secrets" UI
#   instead of uploading a .env file at all.
# =============================================================================

# --- Server -------------------------------------------------------------
PORT=8080
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (CORS allow-list).
# In production this should be your deployed frontend URL ONLY - never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Threat intelligence source APIs -------------------------------------
# VirusTotal (mandatory source #1) - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=replace_with_virustotal_key

# AbuseIPDB (optional/extensible source) - https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=replace_with_abuseipdb_key

# AlienVault OTX (optional/extensible source) - https://otx.alienvault.com/api
OTX_API_KEY=replace_with_otx_key

# Cisco Talos does not offer a self-service free-tier reputation API (its
# Intelligence API requires an enterprise/commercial agreement). ciscoTalos.js
# is wired in as a stub so the module can be dropped in later without any
# refactor - leave this blank until (if) that access is obtained.
CISCO_TALOS_API_KEY=

# --- Generative AI (Gemini) ----------------------------------------------
# Peregrine rotates across up to 4 free-tier Gemini keys to spread usage
# under each key's individual free-tier quota (see geminiKeyPool.js).
# Any of these may be left blank if you have fewer than 4 keys - the pool
# simply skips empty slots.
GEMINI_API_KEY_1=replace_with_gemini_key_1
GEMINI_API_KEY_2=replace_with_gemini_key_2
GEMINI_API_KEY_3=replace_with_gemini_key_3
GEMINI_API_KEY_4=replace_with_gemini_key_4
GEMINI_MODEL=gemini-2.0-flash

# --- Database --------------------------------------------------------------
# Path to the local SQLite file used as the search-history / matrix cache.
SQLITE_DB_PATH=./data/peregrine.sqlite
